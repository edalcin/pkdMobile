# Assinatura de release (usadas só em build local de release; no CI vêm de GitHub Secrets).
# Sem elas, `./gradlew assembleRelease` cai para a assinatura de debug.
PKD_KEYSTORE_PATH=<caminho/para/pkdmobile-release.jks>
PKD_KEYSTORE_PASSWORD=<senha-do-keystore>
PKD_KEY_ALIAS=<alias-da-chave>
PKD_KEY_PASSWORD=<senha-da-chave>

# Usada só no CI (GitHub Actions), como Secret PKD_KEYSTORE_BASE64:
# o keystore acima em base64, decodificado em runtime antes do assembleRelease.
PKD_KEYSTORE_BASE64=<keystore .jks em base64>
